---
import CtaBand from "../components/CtaBand.astro"
import Icon from "../components/Icon.astro"
import PageHero from "../components/PageHero.astro"
import Photo from "../components/Photo.astro"
import Base from "../layouts/Base.astro"
import { loadSite } from "../lib/content"
import { breadcrumbList, graph, webPage } from "../lib/jsonld"

const { settings: s } = await loadSite()
const paragraphs = s.designText.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)
const lead = "Ürün seçiminden kaplama, baskı ve iç düzene kadar markanıza özel üretim."
const STEPS = [
  { title: "Danışmanlık", text: "Hedef kitlenize ve bütçenize uygun ürünü birlikte seçiyoruz." },
  { title: "Tasarım", text: "Grafik ekibimiz logo, yaldız, gofre ve baskı uygulamasını hazırlıyor." },
  { title: "Numune", text: "Onayınız için malzeme ve renk seçenekli numune çıkarıyoruz." },
  { title: "Üretim ve teslim", text: "Onaylanan tasarım kendi tesisimizde üretilip teslim ediliyor." },
]
const jsonLd = graph(
  webPage({ site: Astro.site!, path: "/tasarim-ve-ozellestirme/", name: "Tasarım ve Özelleştirme", description: lead }),
  breadcrumbList([{ name: "Ana sayfa", path: "/" }, { name: "Tasarım ve Özelleştirme", path: "/tasarim-ve-ozellestirme/" }], Astro.site!),
)
---
<Base title="Tasarım ve Özelleştirme" path="/tasarim-ve-ozellestirme/" description={lead} jsonLd={jsonLd}>
  <PageHero title="Tasarım ve Özelleştirme" lead={lead} crumbs={[]} />
  <section class="section">
    <div class="wrap grid items-start gap-14 lg:grid-cols-2">
      <div class="prose-body">
        {paragraphs.map((p) => <p class="text-[1.05rem]">{p}</p>)}
      </div>
      {s.designImage && (
        <div class="framed ml-3 aspect-[4/3]">
          <Photo img={s.designImage} alt="Sıvama kutu" sizes="(min-width: 1024px) 560px, 100vw" loading="eager" width={1200} />
        </div>
      )}
    </div>
  </section>
  <section class="section border-t border-line bg-paper">
    <div class="wrap">
      <h2 class="title">Nasıl çalışıyoruz?</h2>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {STEPS.map((st, i) => (
          <li class="card p-6">
            <span class="feature-num" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-4 text-lg">{st.title}</h3>
            <p class="muted mt-2">{st.text}</p>
          </li>
        ))}
      </ol>
      <a href="/iletisim/#form" class="btn btn-primary mt-10">Projenizi anlatın<Icon name="arrow" /></a>
    </div>
  </section>
  <CtaBand />
</Base>
