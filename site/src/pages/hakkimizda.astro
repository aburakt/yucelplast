---
import CtaBand from "../components/CtaBand.astro"
import PageHero from "../components/PageHero.astro"
import Photo from "../components/Photo.astro"
import Base from "../layouts/Base.astro"
import { loadSite } from "../lib/content"
import { breadcrumbList, graph, webPage } from "../lib/jsonld"

const { settings: s, features } = await loadSite()
const paragraphs = s.aboutText.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)
const lead = s.since ? `${s.since} yılından bu yana Ankara'da markalara özel dosya, kap ve kutu üretiyoruz.` : undefined
const jsonLd = graph(
  webPage({ site: Astro.site!, path: "/hakkimizda/", name: "Hakkımızda", description: lead, type: "AboutPage" }),
  breadcrumbList([{ name: "Ana sayfa", path: "/" }, { name: "Hakkımızda", path: "/hakkimizda/" }], Astro.site!),
)
---
<Base title="Hakkımızda" path="/hakkimizda/" description={lead} jsonLd={jsonLd}>
  <PageHero title="Hakkımızda" lead={lead} crumbs={[]} />
  <section class="section">
    <div class="wrap grid items-center gap-14 lg:grid-cols-2">
      <div>
        <h2 class="title text-brand">{s.companyName}</h2>
        <p class="mt-3 text-lg font-semibold text-ink-soft">{s.aboutTitle}</p>
        {paragraphs.map((p) => <p class="muted mt-4 text-[1.05rem]">{p}</p>)}
      </div>
      {s.aboutImage && (
        <div class="tinted aspect-[4/3]">
          <Photo img={s.aboutImage} alt={`${s.companyName} fabrika binası`} sizes="(min-width: 1024px) 560px, 100vw" loading="eager" width={1200} />
        </div>
      )}
    </div>
  </section>
  {features.length > 0 && (
    <section class="section bg-mist">
      <div class="wrap grid items-center gap-14 lg:grid-cols-2">
        {s.aboutImage2 && (
          <div class="framed ml-3 aspect-[4/3]">
            <Photo img={s.aboutImage2} alt={`${s.companyName} üretim alanı`} sizes="(min-width: 1024px) 560px, 100vw" width={1200} />
          </div>
        )}
        <div>
          <h2 class="title title-rule">Neden {s.companyName}?</h2>
          <div class="acc mt-8 grid gap-2">
            {features.map((f, i) => (
              <details name="neden" open={i === 0}>
                <summary>{f.title}</summary>
                <p>{f.text}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
  <CtaBand />
</Base>
