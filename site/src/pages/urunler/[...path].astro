---
import CategoryIcon from "../../components/CategoryIcon.astro"
import CategoryCard from "../../components/CategoryCard.astro"
import CtaBand from "../../components/CtaBand.astro"
import Icon from "../../components/Icon.astro"
import PageHero from "../../components/PageHero.astro"
import Photo from "../../components/Photo.astro"
import Base from "../../layouts/Base.astro"
import { childrenOf, loadSite } from "../../lib/content"
import { breadcrumbList, graph, webPage } from "../../lib/jsonld"
import { sanitize } from "../../lib/sanitize"
import type { Category } from "../../lib/types"

// Ürün grubu: /urunler/<slug>/ ya da alt grup /urunler/<üst>/<slug>/. Yalnız yayındaki gruplar üretilir.
export async function getStaticPaths() {
  const site = await loadSite()
  return site.categories.map((category) => ({
    params: { path: category.path.slice("/urunler/".length, -1) },
    props: { category, children: childrenOf(site, category.slug), parent: site.categories.find((c) => c.slug === category.parent) },
  }))
}

const { category: c, children, parent } = Astro.props as { category: Category; children: Category[]; parent?: Category }
const crumbs = [{ href: "/urunler/", label: "Ürünler" }, ...(parent ? [{ href: parent.path, label: parent.title }] : [])]
const jsonLd = graph(
  webPage({ site: Astro.site!, path: c.path, name: c.title, description: c.summary, type: "CollectionPage" }),
  breadcrumbList([{ name: "Ana sayfa", path: "/" }, ...crumbs.map((x) => ({ name: x.label, path: x.href })), { name: c.title, path: c.path }], Astro.site!),
)
const body = c.body ? sanitize(c.body) : ""
---
<Base title={c.title} path={c.path} description={c.summary} jsonLd={jsonLd}>
  <PageHero title={c.title} lead={c.summary} crumbs={crumbs} icon={c.icon} />

  {children.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="title title-rule">{c.title} çeşitleri</h2>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {children.map((k) => <li class="flex"><CategoryCard category={k} /></li>)}
        </ul>
      </div>
    </section>
  )}

  {c.products.length > 0 && (
    <section class:list={["section", children.length > 0 && "bg-mist"]}>
      <div class="wrap">
        <h2 class="title title-rule">{children.length > 0 ? "Diğer modeller" : "Modeller"}</h2>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {c.products.map((p) => (
            <li class="flex">
              <div class="box-card">
                <div class:list={["box-media", !p.image && "icon"]}>
                  {p.image ? <Photo img={p.image} alt={p.title} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" width={800} /> : <CategoryIcon name={c.icon} />}
                </div>
                <div class="box-body">
                  <h3>{p.title}</h3>
                  {p.description && <p>{p.description}</p>}
                  <a href="/iletisim/#form" class="box-btn">Teklif iste</a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {(body || c.cover) && (
    <section class="section border-t border-line">
      <div class:list={["wrap grid gap-12", c.cover && "lg:grid-cols-[1fr_1.05fr] lg:items-start"]}>
        <div>
          <h2 class="title title-rule text-brand">{c.title}</h2>
          {body && <div class="prose-body mt-6" set:html={body} />}
          <a href="/iletisim/#form" class="btn btn-primary mt-8">Bu ürün için teklif isteyin<Icon name="arrow" /></a>
        </div>
        {c.cover && (
          <div class="framed ml-3 aspect-[4/3]">
            <Photo img={c.cover} alt={c.title} sizes="(min-width: 1024px) 560px, 100vw" width={1200} />
          </div>
        )}
      </div>
    </section>
  )}

  {c.gallery.length > 0 && (
    <section class="section bg-mist">
      <div class="wrap">
        <h2 class="title title-rule">Fotoğraflar</h2>
        <div class="gallery mt-10">
          {c.gallery.map((g, i) => <Photo img={g} alt={`${c.title}, fotoğraf ${i + 1}`} sizes="(min-width: 768px) 33vw, 50vw" width={800} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
