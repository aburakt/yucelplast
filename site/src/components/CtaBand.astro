---
import { loadSite } from "../lib/content"

// Sayfa sonu şeridi (eski sitedeki "Siz de kaliteli ve özgün çözümler için bize ulaşın!").
const { settings: s } = await loadSite()
---
<section class="wrap pb-16 md:pb-20">
  <div class="cta-strip">
    <strong>{s.companyName}</strong>
    <p>Siz de kaliteli ve özgün çözümler için bize ulaşın!</p>
    <a href="/iletisim/#form">İletişim</a>
  </div>
</section>
