---
import Icon from "./Icon.astro"
import type { IconName } from "../lib/icons"

// İç sayfa başlığı (eski sitedeki mavi degrade bant): yol (crumbs verilirse; boş dizi = yalnız Ana sayfa), çizgili başlık,
// isteğe bağlı giriş ve sağda büyük beyaz simge. Yol JSON-LD'si sayfanın kendisinde.
interface Props { title: string; lead?: string; crumbs?: { href: string; label: string }[]; icon?: IconName }
const { title, lead, crumbs, icon } = Astro.props
---
<section class="band page-band border-t border-white/10">
  <div class="wrap flex items-center justify-between gap-8 py-10 md:py-14">
    <div>
      {crumbs && (
        <nav aria-label="Konum">
          <ol class="crumbs">
            <li><a href="/">Ana sayfa</a></li>
            {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
      )}
      <h1 class="mt-3 text-[clamp(1.9rem,4.2vw,2.9rem)]">{title}</h1>
      {lead && <p class="mt-3 max-w-[60ch] text-[1.05rem] text-[#d3e5f4]">{lead}</p>}
      <slot />
    </div>
    {icon && <Icon name={icon} stroke={1.1} class="band-icon hidden shrink-0 sm:block" />}
  </div>
</section>
