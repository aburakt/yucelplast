---
import CategoryIcon from "./CategoryIcon.astro"
import Photo from "./Photo.astro"
import type { Category } from "../lib/types"

// Ürün grubu kartı (eski sitedeki gibi): üstte fotoğraf (yoksa mavi zeminde simge), altta mavi kutuda ad ve "İncele".
// level: kart başlığının seviyesi.
interface Props { category: Category; level?: 2 | 3 }
const { category: c, level = 3 } = Astro.props
const H = `h${level}` as "h2" | "h3"
---
<a href={c.path} class="box-card">
  <div class:list={["box-media", !c.cover && "icon"]}>
    {c.cover ? <Photo img={c.cover} alt="" sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" width={800} /> : <CategoryIcon name={c.icon} />}
  </div>
  <div class="box-body">
    <H>{c.title}</H>
    {c.summary && <p>{c.summary}</p>}
    <span class="box-btn">İncele</span>
  </div>
</a>
