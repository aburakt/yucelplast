---
import "../styles/global.css"
import ErrorTracking from "../components/ErrorTracking.astro"
import Geo from "../components/Geo.astro"
import Head from "../components/Head.astro"
import Icon from "../components/Icon.astro"
import Logo from "../components/Logo.astro"
import { loadSite, topCategories } from "../lib/content"
import { lines, telHref } from "../lib/format"
import { type Alternate, DEFAULT_LANG, type Lang } from "../lib/i18n"
import { MENU, mapsHref } from "../lib/nav"
import { isFixtureMode } from "../lib/pb"
import { cfBeacon } from "../lib/seo"

// lang/alternates yalnız çok dilli sitede verilir (docs/i18n.md); varsayılan tek dil.
interface Props { title?: string; path: string; description?: string; jsonLd?: object; lang?: Lang; alternates?: Alternate[] }
const { title, path, description, jsonLd, lang = DEFAULT_LANG, alternates = [] } = Astro.props
const site = await loadSite()
const { settings: s, pages } = site
const cats = topCategories(site)
const year = new Date().getFullYear()
const current = (href: string) => (path === href || (href !== "/" && path.startsWith(href)) ? "page" : undefined)
// Çerezsiz ziyaret sayacı (Cloudflare Web Analytics): dış betik, inline kod yok; önizlemede (fixture) eklenmez.
const beacon = isFixtureMode() ? undefined : cfBeacon(s.cfAnalyticsToken)
---
<!doctype html>
<html lang={lang}>
  <head>
    <Head title={title} path={path} description={description} jsonLd={jsonLd} lang={lang} alternates={alternates} />
    <Geo path={path} />
    <ErrorTracking />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-paper focus:px-3 focus:py-2">İçeriğe geç</a>
    {isFixtureMode() && <p data-fixture-banner class="fixture-banner">Önizleme: örnek içerik (PocketBase bağlı değil)</p>}
    <header class="sticky top-0 z-30 border-b border-line bg-paper/95 backdrop-blur">
      <div class="wrap flex h-[4.75rem] items-center justify-between gap-6">
        <a href="/" class="text-brand no-underline" aria-label={`${s.companyName}, ana sayfa`}><Logo class="h-10 w-auto md:h-12" /></a>
        <nav aria-label="Ana menü" class="site-nav hidden items-center gap-7 whitespace-nowrap text-[0.95rem] lg:flex">
          {MENU.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
        </nav>
        <div class="flex items-center gap-3">
          {s.phone && <a href={telHref(s.phone)} class="hidden items-center gap-2 font-semibold text-ink no-underline xl:inline-flex"><Icon name="phone" class="h-4 w-4 text-brand" />{s.phone}</a>}
          <a href="/iletisim/#form" class="btn btn-primary hidden sm:inline-flex">Teklif isteyin</a>
          <details class="menu relative lg:hidden">
            <summary class="btn btn-ghost px-3" aria-label="Menüyü aç"><Icon name="burger" /></summary>
            <nav aria-label="Mobil menü" class="site-nav card absolute right-0 top-full z-40 mt-3 grid w-[min(20rem,calc(100vw-2.5rem))] gap-0.5 p-2 shadow-xl">
              {MENU.map((n) => <a href={n.href} aria-current={current(n.href)} class="rounded-md px-3 py-2.5 hover:bg-canvas">{n.label}</a>)}
              {s.phone && <a href={telHref(s.phone)} class="rounded-md px-3 py-2.5 hover:bg-canvas">{s.phone}</a>}
              <a href="/iletisim/#form" class="btn btn-primary mt-2">Teklif isteyin</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1"><slot /></main>

    <footer class="on-dark">
      <div class="wrap grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.1fr]">
        <div>
          <Logo class="h-11 w-auto text-white" />
          <p class="muted mt-5 max-w-[34ch] text-sm">{s.since ? `${s.since} yılından bu yana ` : ""}markalara özel dosya, kap, kutu ve promosyon ürünleri üretiyoruz.</p>
        </div>
        <div>
          <h2 class="text-sm font-semibold tracking-wide text-white uppercase">Ürünler</h2>
          <ul class="mt-4 grid gap-2 text-sm">
            {cats.map((c) => <li><a href={c.path} class="no-underline hover:underline">{c.title}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold tracking-wide text-white uppercase">Kurumsal</h2>
          <ul class="mt-4 grid gap-2 text-sm">
            {MENU.filter((n) => n.href !== "/urunler/").map((n) => <li><a href={n.href} class="no-underline hover:underline">{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold tracking-wide text-white uppercase">İletişim</h2>
          <address class="mt-4 grid gap-2 text-sm not-italic">
            <span>{lines(s.address).map((l) => <span class="block">{l}</span>)}</span>
            <a href={mapsHref(s.mapsUrl, s.address)} rel="noopener" target="_blank" class="arrow-link text-sm">Haritada aç<Icon name="arrow" /></a>
            {s.phone && <a href={telHref(s.phone)} class="no-underline hover:underline">{s.phone}</a>}
            {s.phone2 && <a href={telHref(s.phone2)} class="no-underline hover:underline">{s.phone2}</a>}
            {s.email && <a href={`mailto:${s.email}`} class="no-underline hover:underline">{s.email}</a>}
          </address>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="wrap muted flex flex-wrap items-center gap-x-6 gap-y-2 py-6 text-xs">
          <p>© {year} {s.companyName}</p>
          {pages.length > 0 && (
            <nav aria-label="Yasal bilgiler" class="flex flex-wrap gap-x-6 gap-y-2">
              {pages.map((p) => <a href={`/${p.slug}/`} class="no-underline hover:underline">{p.title}</a>)}
            </nav>
          )}
        </div>
      </div>
    </footer>
    <script>
      import "../scripts/console-egg"
    </script>
    {beacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={beacon}></script>}
  </body>
</html>
